menu "ChatTTS / uplink network"

config TTS_SERVER_URL
    string "ChatTTS streaming URL"
    default "http://192.168.1.92:8000/tts/stream"
    help
        ChatTTS streaming endpoint used by startup prompts, status queries,
        and dialog-mode voice feedback.

        Current verified development server:
        http://192.168.1.92:8000/tts/stream

        Set this to an empty string in menuconfig only when you explicitly
        want to disable TTS playback while keeping the rest of the
        voice/camera application working normally.

config TTS_WIFI_STA_ENABLE
    bool "Enable Wi-Fi STA uplink in addition to S3CAM-Photo SoftAP"
    default n
    help
        Keep the existing S3CAM-Photo SoftAP/web page, and also connect the
        ESP32 to an existing LAN so it can reach the ChatTTS server.

        This changes Wi-Fi mode from AP to AP+STA. The SoftAP remains available
        at http://192.168.4.1/.

if TTS_WIFI_STA_ENABLE

config TTS_WIFI_STA_SSID
    string "Uplink Wi-Fi SSID"
    default ""

config TTS_WIFI_STA_PASSWORD
    string "Uplink Wi-Fi password"
    default ""

endif

endmenu
