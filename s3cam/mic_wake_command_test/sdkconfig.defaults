# ESP32-S3 + ESP-SR wake word / Chinese command recognition test
# 这份配置按当前板子的 16MB Flash，并参考 ESP-Skainet 官方 ESP32-S3 示例。

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# ESP-SR：WakeNet + 中文 MultiNet6
# CONFIG_SR_WN_WN9_HILEXIN=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
CONFIG_SR_MN_CN_MULTINET6_QUANT=y

# ESP-SR 完整唤醒 + 命令识别需要较多内存；ESP32-S3 语音示例通常启用 PSRAM。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 语音推理优先使用 240MHz。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
