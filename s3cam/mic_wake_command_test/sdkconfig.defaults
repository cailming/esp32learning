# ESP32-S3 + ESP-SR wake word / Chinese command recognition test
# 这份配置按当前板子的 16MB Flash，并参考 ESP-SR 官方 ESP32-S3 配置。

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# ESP-SR：WakeNet10 + 中文 MultiNet6
# 唤醒词：你好小智
# 模型：wn10_nihaoxiaozhi
CONFIG_SR_WN_WN10_NIHAOXIAOZHI=y
CONFIG_SR_MN_CN_MULTINET6_QUANT=y

# ESP-SR 完整唤醒 + 命令识别需要较多内存；ESP32-S3 语音示例通常启用 PSRAM。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 语音推理优先使用 240MHz。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ChatTTS：当前开发环境已经验证可用的 streaming endpoint。
# 这里只固化服务地址，不把 Wi-Fi SSID / 密码写入仓库。
CONFIG_TTS_SERVER_URL="http://192.168.1.92:8000/tts/stream"
