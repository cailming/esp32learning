# 这是一份叠加在 sdkconfig.defaults 之上的配置，用来把 BLE UART 后端
# 从默认的 NimBLE 切换成 Bluedroid。
#
# 例如可以这样构建：
#
#   idf.py -B build_bd \
#       -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.bluedroid" \
#       reconfigure
#   idf.py -B build_bd build flash monitor
#
# 当这份 overlay 生效后：
# - NimBLE 被关闭；
# - Bluedroid 被开启；
# - ble_uart 组件会编译 Bluedroid 对应后端，而不是 NimBLE 后端。
#
# 对上层应用来说，ble_uart.h 的公开 API 不变，
# 所以 main.c 不需要因为底层 Host 从 NimBLE 换成 Bluedroid 而改写。

CONFIG_BT_ENABLED=y

CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=y

# 开启 BLE SMP 安全功能，以支持 LE Secure Connections / 配对 / Bonding。
# CONFIG_BT_SMP_ENABLE 会由相关蓝牙配置推导，这里不需要手工重复设置。
CONFIG_BT_BLE_SMP_ENABLE=y

# Bluedroid 没有类似 NimBLE 的 CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU 编译期选项。
# 如果需要更大的 ATT MTU，可以在运行时、设备连接之前调用：
#
#     esp_ble_gatt_set_local_mtu(<bytes>)
#
# ble_uart_tx() 会按照当前实际生效的 MTU 自动分片，
# 因此即使使用默认 MTU 23 也能工作，只是吞吐率会更低。

# 开启 GATT Server Service Table API。
# Bluedroid 后端创建 BLE UART GATT 属性表时需要 esp_ble_gatts_create_attr_tab()。
CONFIG_BT_GATTS_ENABLE=y

# 本示例作为 GATT Server 使用，不需要开启 GATT Client。
# CONFIG_BT_GATTC_ENABLE is not set

# 使用 BLE 4.2 功能集，不启用 BLE 5.0 功能集。
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# 不启用 BLE 4.2 DTM 测试模式。
# CONFIG_BT_BLE_42_DTM_TEST_EN is not set

# 开启 BLE 4.2 广播功能。
CONFIG_BT_BLE_42_ADV_EN=y

# 本设备是 Peripheral / GATT Server，主要负责广播并等待 Central 连接，
# 因此这里不启用扫描功能。
# CONFIG_BT_BLE_42_SCAN_EN is not set
